{
  "name": "fashion-store-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Production monorepo for modern fashion retail platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,magenta\" \"npm run dev --workspace=@fashion-store/api\" \"npm run dev --workspace=@fashion-store/web\"",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@fashion-store/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:seed": "npm run prisma:seed --workspace=@fashion-store/api",
    "prisma:generate": "npm run prisma:generate --workspace=@fashion-store/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@fashion-store/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.1",
    "@vitejs/plugin-react": "^4.3.4"
  }
}
