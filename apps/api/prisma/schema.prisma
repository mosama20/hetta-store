// Fashion Store — Production Prisma Schema
// Database Architecture Phase 2B

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS
// ==========================================

enum OrderStatus {
  PENDING
  CONTACTED
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT

  @@map("discount_type")
}

enum StorageProvider {
  LOCAL
  S3
  CLOUDINARY
  GCS

  @@map("storage_provider")
}

enum CMSSectionType {
  HERO_SLIDER
  PROMO_BANNER
  FEATURED_GRID
  CATEGORY_CAROUSEL
  CUSTOM_HTML

  @@map("cms_section_type")
}

enum SettingGroup {
  GENERAL
  BRANDING
  WHATSAPP
  SOCIAL

  @@map("setting_group")
}

// ==========================================
// 2. IDENTITY & ACCESS CONTROL (RBAC)
// ==========================================

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  uploadedMedia Media[]

  @@index([email], name: "idx_users_email")
  @@index([isActive], name: "idx_users_is_active")
  @@map("users")
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique @db.VarChar(50)
  displayNameAr String   @map("display_name_ar") @db.VarChar(100)
  displayNameEn String   @map("display_name_en") @db.VarChar(100)
  description   String?  @db.Text
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@index([name], name: "idx_roles_name")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@index([name], name: "idx_permissions_name")
  @@index([module], name: "idx_permissions_module")
  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId], name: "idx_user_roles_user_id")
  @@index([roleId], name: "idx_user_roles_role_id")
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId], name: "idx_role_permissions_role_id")
  @@index([permissionId], name: "idx_role_permissions_permission_id")
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user_id")
  @@index([tokenHash], name: "idx_refresh_tokens_token_hash")
  @@index([expiresAt], name: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

// ==========================================
// 3. CATALOG TAXONOMY & ATTRIBUTES
// ==========================================

model Category {
  id            String   @id @default(uuid()) @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  nameAr        String   @map("name_ar") @db.VarChar(100)
  nameEn        String   @map("name_en") @db.VarChar(100)
  slug          String   @unique @db.VarChar(120)
  descriptionAr String?  @map("description_ar") @db.Text
  descriptionEn String?  @map("description_en") @db.Text
  imageUrl      String?  @map("image_url") @db.Text
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent             Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]         @relation("CategoryHierarchy")
  products           Product[]
  discountCategories DiscountCategory[]

  @@index([slug], name: "idx_categories_slug")
  @@index([parentId], name: "idx_categories_parent_id")
  @@index([displayOrder], name: "idx_categories_display_order")
  @@index([isActive], name: "idx_categories_is_active")
  @@map("categories")
}

model Color {
  id           String   @id @default(uuid()) @db.Uuid
  nameAr       String   @map("name_ar") @db.VarChar(50)
  nameEn       String   @map("name_en") @db.VarChar(50)
  hexCode      String   @map("hex_code") @db.VarChar(7)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productVariants ProductVariant[]
  productImages   ProductImage[]

  @@index([displayOrder], name: "idx_colors_display_order")
  @@index([isActive], name: "idx_colors_is_active")
  @@map("colors")
}

model Size {
  id           String   @id @default(uuid()) @db.Uuid
  nameAr       String   @map("name_ar") @db.VarChar(30)
  nameEn       String   @map("name_en") @db.VarChar(30)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  productVariants ProductVariant[]

  @@index([displayOrder], name: "idx_sizes_display_order")
  @@index([isActive], name: "idx_sizes_is_active")
  @@map("sizes")
}

// ==========================================
// 4. PRODUCTS & VARIANTS
// ==========================================

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  nameAr        String    @map("name_ar") @db.VarChar(200)
  nameEn        String    @map("name_en") @db.VarChar(200)
  slug          String    @unique @db.VarChar(220)
  descriptionAr String?   @map("description_ar") @db.Text
  descriptionEn String?   @map("description_en") @db.Text
  basePrice     Decimal   @map("base_price") @db.Decimal(10, 2)
  isFeatured    Boolean   @default(false) @map("is_featured")
  isActive      Boolean   @default(true) @map("is_active")
  seoTitleAr    String?   @map("seo_title_ar") @db.VarChar(150)
  seoTitleEn    String?   @map("seo_title_en") @db.VarChar(150)
  seoDescAr     String?   @map("seo_desc_ar") @db.VarChar(255)
  seoDescEn     String?   @map("seo_desc_en") @db.VarChar(255)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  images           ProductImage[]
  discountProducts DiscountProduct[]

  @@index([slug], name: "idx_products_slug")
  @@index([categoryId], name: "idx_products_category_id")
  @@index([isActive], name: "idx_products_is_active")
  @@index([isFeatured], name: "idx_products_is_featured")
  @@index([deletedAt], name: "idx_products_deleted_at")
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  colorId           String   @map("color_id") @db.Uuid
  sizeId            String   @map("size_id") @db.Uuid
  sku               String   @unique @db.VarChar(50)
  price             Decimal  @db.Decimal(10, 2)
  compareAtPrice    Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  stockQuantity     Int      @default(0) @map("stock_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      Color       @relation(fields: [colorId], references: [id], onDelete: Restrict)
  size       Size        @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([productId, colorId, sizeId], name: "uq_variants_product_color_size")
  @@index([sku], name: "idx_variants_sku")
  @@index([productId], name: "idx_variants_product_id")
  @@index([stockQuantity], name: "idx_variants_stock_quantity")
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  colorId      String?  @map("color_id") @db.Uuid
  url          String   @db.Text
  altTextAr    String?  @map("alt_text_ar") @db.VarChar(200)
  altTextEn    String?  @map("alt_text_en") @db.VarChar(200)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId], name: "idx_product_images_product_id")
  @@index([colorId], name: "idx_product_images_color_id")
  @@index([isPrimary], name: "idx_product_images_is_primary")
  @@map("product_images")
}

// ==========================================
// 5. PROMOTIONS & DISCOUNTS
// ==========================================

model Discount {
  id         String       @id @default(uuid()) @db.Uuid
  nameAr     String       @map("name_ar") @db.VarChar(100)
  nameEn     String       @map("name_en") @db.VarChar(100)
  type       DiscountType
  value      Decimal      @db.Decimal(10, 2)
  startDate  DateTime     @map("start_date") @db.Timestamptz
  endDate    DateTime?    @map("end_date") @db.Timestamptz
  isActive   Boolean      @default(true) @map("is_active")
  applyToAll Boolean      @default(false) @map("apply_to_all")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  discountProducts   DiscountProduct[]
  discountCategories DiscountCategory[]

  @@index([isActive], name: "idx_discounts_is_active")
  @@index([startDate, endDate], name: "idx_discounts_schedule")
  @@map("discounts")
}

model DiscountProduct {
  discountId String @map("discount_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([discountId, productId])
  @@index([discountId], name: "idx_discount_products_discount_id")
  @@index([productId], name: "idx_discount_products_product_id")
  @@map("discount_products")
}

model DiscountCategory {
  discountId String @map("discount_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  discount Discount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([discountId, categoryId])
  @@index([discountId], name: "idx_discount_categories_discount_id")
  @@index([categoryId], name: "idx_discount_categories_category_id")
  @@map("discount_categories")
}

// ==========================================
// 6. ORDERS & WHATSAPP
// ==========================================

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(30)
  customerName    String      @map("customer_name") @db.VarChar(150)
  customerPhone   String      @map("customer_phone") @db.VarChar(30)
  customerCity    String?     @map("customer_city") @db.VarChar(100)
  customerAddress String?     @map("customer_address") @db.Text
  notes           String?     @db.Text
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  currency        String      @default("EGP") @db.VarChar(10)
  whatsappMessage String?     @map("whatsapp_message") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  items OrderItem[]

  @@index([orderNumber], name: "idx_orders_order_number")
  @@index([customerPhone], name: "idx_orders_customer_phone")
  @@index([status], name: "idx_orders_status")
  @@index([createdAt], name: "idx_orders_created_at")
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  variantId     String?  @map("variant_id") @db.Uuid
  skuSnapshot   String   @map("sku_snapshot") @db.VarChar(50)
  productNameAr String   @map("product_name_ar") @db.VarChar(200)
  productNameEn String   @map("product_name_en") @db.VarChar(200)
  colorNameAr   String   @map("color_name_ar") @db.VarChar(50)
  colorNameEn   String   @map("color_name_en") @db.VarChar(50)
  sizeNameAr    String   @map("size_name_ar") @db.VarChar(30)
  sizeNameEn    String   @map("size_name_en") @db.VarChar(30)
  unitPrice     Decimal  @map("unit_price") @db.Decimal(10, 2)
  quantity      Int      @default(1)
  subtotal      Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId], name: "idx_order_items_order_id")
  @@index([variantId], name: "idx_order_items_variant_id")
  @@index([skuSnapshot], name: "idx_order_items_sku_snapshot")
  @@map("order_items")
}

// ==========================================
// 7. DYNAMIC CMS & STORE CONFIGURATION
// ==========================================

model CMSSection {
  id           String         @id @default(uuid()) @db.Uuid
  key          String         @unique @db.VarChar(60)
  type         CMSSectionType
  titleAr      String?        @map("title_ar") @db.VarChar(150)
  titleEn      String?        @map("title_en") @db.VarChar(150)
  subtitleAr   String?        @map("subtitle_ar") @db.VarChar(255)
  subtitleEn   String?        @map("subtitle_en") @db.VarChar(255)
  payload      Json           @default("{}") @db.JsonB
  displayOrder Int            @default(0) @map("display_order")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@index([key], name: "idx_cms_sections_key")
  @@index([displayOrder], name: "idx_cms_sections_display_order")
  @@index([isActive], name: "idx_cms_sections_is_active")
  @@map("cms_sections")
}

model StoreSetting {
  id        String       @id @default(uuid()) @db.Uuid
  key       String       @unique @db.VarChar(80)
  value     String       @db.Text
  group     SettingGroup @default(GENERAL)
  isPublic  Boolean      @default(true) @map("is_public")
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([key], name: "idx_store_settings_key")
  @@index([group], name: "idx_store_settings_group")
  @@map("store_settings")
}

// ==========================================
// 8. MEDIA & AUDIT LOGGING
// ==========================================

model Media {
  id               String          @id @default(uuid()) @db.Uuid
  url              String          @db.Text
  storageProvider  StorageProvider @default(LOCAL) @map("storage_provider")
  storageKey       String?         @map("storage_key") @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(60)
  fileSize         Int             @map("file_size")
  width            Int?
  height           Int?
  altTextAr        String?         @map("alt_text_ar") @db.VarChar(200)
  altTextEn        String?         @map("alt_text_en") @db.VarChar(200)
  uploadedByUserId String?         @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  uploadedBy User? @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([storageProvider], name: "idx_media_storage_provider")
  @@index([createdAt], name: "idx_media_created_at")
  @@map("media")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(100)
  oldValues Json?    @map("old_values") @db.JsonB
  newValues Json?    @map("new_values") @db.JsonB
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], name: "idx_audit_logs_user_id")
  @@index([action], name: "idx_audit_logs_action")
  @@index([entity, entityId], name: "idx_audit_logs_entity_entity_id")
  @@index([createdAt], name: "idx_audit_logs_created_at")
  @@map("audit_logs")
}
